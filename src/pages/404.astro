---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Page not found"><div class="container error-page"><span class="eyebrow"><span class="eyebrow-rule"></span>Error 404</span><h1>This page is beyond the map.</h1><p>The page you're looking for does not exist or has moved.</p><ArrowLink href={withBase('/')} text="Return to the homepage" /></div></BaseLayout>
