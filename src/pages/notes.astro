---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../utils/paths';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
/* Each note gets a stable anchor derived from its title, so a single note can be linked and shared. */
const slugify = (value: string) => value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const pageUrl = new URL(withBase('/notes/'), Astro.site ?? 'https://www.bladimirgarcia.com').href;
const rendered = await Promise.all(notes.map(async (note) => {
  const slug = slugify(note.data.title);
  const noteUrl = `${pageUrl}#${slug}`;
  return { note, slug, noteUrl, Content: (await render(note)).Content };
}));
---
<BaseLayout title="Notes" description="Short notes for interested visitors.">
  <section class="container section-page notes-page">
    <h1>Notes</h1>

    {rendered.length === 0
      ? <p class="empty-note">New notes will appear here when they are published.</p>
      : rendered.map(({ note, slug, noteUrl, Content }) => (
          <article class="note-item" id={slug}>
            <h2>{note.data.title}</h2>
            <p class="meta note-date">{note.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
            <div class="note-body"><Content /></div>
            <p class="note-share">Share this note: <a href={`mailto:?subject=${encodeURIComponent(note.data.title)}&body=${encodeURIComponent(noteUrl)}`}>Email</a> <span aria-hidden="true">·</span> <a href={noteUrl}>Direct link</a></p>
          </article>
        ))}
  </section>
</BaseLayout>
