---
/** Grey "Personal profile" card, shared by the homepage and the About page. */
import { site } from '../data/site';
import { withBase } from '../utils/paths';
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<div class:list={['profile-card', className]}>
  <h2>Personal profile</h2>
  <p>{site.givenName} is a scholar of Hispanic Studies. His academic work is concerned with the ways political claims become entangled with the experience of belonging. His doctoral enquiry focuses on the Belize–Guatemala territorial dispute and explores the relationship between territorial uncertainty and the language of identity.</p>
  <p>Beyond this research, he writes short philosophical works on contemporary human concerns, collected as <a href={withBase('/writing/')}><em>The Human Measure</em></a>. Those essays are pursued as an independent undertaking rather than as an extension of his dissertation.</p>
  <p>He has taught Hispanic Studies at the university level and now works in world-language education in Pennsylvania.</p>
</div>
